generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserAccountType {
  FREE
  PREMIUM
}

enum UserRole {
  USER
  ADMIN
}

enum PaymentProvider {
  VIETQR
}

enum ActivationSource {
  PAYMENT
  ADMIN
}

enum SubscriptionStatus {
  INACTIVE
  ACTIVE
  CANCELED
  EXPIRED
}

enum TxStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum ReconcileMethod {
  MANUAL
  AUTO
}

model User {
  google_id    String?         @unique
  id           String          @id @default(uuid()) @db.Char(36)
  email        String          @unique @db.VarChar(255)
  password     String          @db.VarChar(255)
  name         String          @db.VarChar(100)
  avatar_url   String?         @db.VarChar(500)
  account_type UserAccountType @default(FREE)

  role      UserRole  @default(USER)
  is_banned Boolean   @default(false)
  banned_at DateTime? @db.DateTime(0)

  created_at DateTime  @default(now()) @db.DateTime(0)
  deleted_at DateTime? @db.DateTime(0)

  tasks    Task[]
  expenses Expense[]
  budgets  Budget[]

  streak UserStreak? // ✅ NEW

  // ✅ Opposite relations (required)
  subscription        Subscription?        @relation("UserSubscription")
  paymentTransactions PaymentTransaction[] @relation("UserPaymentTransactions")

  @@map("users")
}

model Task {
  id           String    @id @default(uuid()) @db.Char(36)
  title        String    @db.VarChar(255)
  description  String?   @db.Text
  is_completed Boolean   @default(false)
  due_date     DateTime? @db.Date

  completed_at DateTime? @db.DateTime(0)
  updated_at   DateTime  @updatedAt @db.DateTime(0)

  user_id String @db.Char(36)
  user    User   @relation(fields: [user_id], references: [id])

  created_at DateTime  @default(now()) @db.DateTime(0)
  deleted_at DateTime? @db.DateTime(0)

  @@index([user_id, is_completed])
  @@index([user_id, completed_at])
  @@map("tasks")
}

model Category {
  id         String    @id @db.Char(36)
  user_id    String    @db.Char(36)
  name       String    @db.VarChar(100)
  created_at DateTime  @default(now()) @db.DateTime(0)
  deleted_at DateTime? @db.DateTime(0)
  expenses   Expense[]

  @@unique([user_id, name], name: "user_id_name")
  @@index([user_id])
  @@index([user_id, deleted_at])
  @@map("category")
}

model Expense {
  id           String   @id @default(uuid()) @db.Char(36)
  amount       Decimal  @db.Decimal(12, 2)
  expense_date DateTime @db.Date
  note         String?  @db.Text

  user_id     String @db.Char(36)
  category_id String @db.Char(36)

  user     User     @relation(fields: [user_id], references: [id])
  category Category @relation(fields: [category_id], references: [id])

  created_at DateTime  @default(now()) @db.DateTime(0)
  deleted_at DateTime? @db.DateTime(0)

  @@map("expenses")
}

model Budget {
  id           String  @id @default(uuid()) @db.Char(36)
  limit_amount Decimal @db.Decimal(12, 2)
  month        Int
  year         Int

  user_id String @db.Char(36)
  user    User   @relation(fields: [user_id], references: [id])

  created_at DateTime  @default(now()) @db.DateTime(0)
  deleted_at DateTime? @db.DateTime(0)

  @@unique([user_id, month, year], name: "user_id_month_year")
  @@map("budgets")
}

model UserStreak {
  user_id          String    @id @db.Char(36)
  current_streak   Int       @default(0)
  longest_streak   Int       @default(0)
  last_streak_date DateTime? @db.Date

  updated_at DateTime @updatedAt @db.DateTime(0)
  created_at DateTime @default(now()) @db.DateTime(0)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("user_streaks")
}

model Subscription {
  id                       String             @id @default(uuid()) @db.Char(36)
  user_id                  String             @unique @db.Char(36)
  provider                 PaymentProvider
  status                   SubscriptionStatus @default(INACTIVE)
  current_period_end       DateTime?          @db.DateTime(0)

  activation_source        ActivationSource   @default(PAYMENT)  // 👈 THÊM DÒNG NÀY

  created_at DateTime @default(now()) @db.DateTime(0)
  updated_at DateTime @updatedAt @db.DateTime(0)

  user         User                 @relation("UserSubscription", fields: [user_id], references: [id], onDelete: Cascade)
  transactions PaymentTransaction[]

  @@map("subscriptions")
}


model PaymentTransaction {
  id              String  @id @default(uuid()) @db.Char(36)
  user_id         String  @db.Char(36)
  subscription_id String? @db.Char(36)

  provider PaymentProvider @default(VIETQR)

  // nội dung chuyển khoản bạn bắt user nhập (unique để đối soát)
  reference_code String @unique @db.VarChar(64)

  amount   Int
  currency String   @default("VND") @db.VarChar(10)
  status   TxStatus @default(PENDING)

  reconcile_method ReconcileMethod @default(MANUAL)
  bank_code        String?         @db.VarChar(20)
  payer_name       String?         @db.VarChar(100)
  note             String?         @db.VarChar(255)

  raw_payload Json?

  created_at DateTime @default(now()) @db.DateTime(0)
  updated_at DateTime @updatedAt @db.DateTime(0)

  user         User          @relation("UserPaymentTransactions", fields: [user_id], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscription_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([subscription_id])
  @@index([status])
  @@map("payment_transactions")
}
